msgid "Wi-Fi schedule"
msgstr "Расписание Wi-Fi"

msgid "Turns off selected Wi-Fi networks for a period of time and turns them back on. Other networks keep working, for example 2.4 GHz for smart-home devices."
msgstr "Выключает выбранные Wi-Fi сети на заданное время и потом включает обратно. Остальные сети продолжают работать, например 2.4 ГГц для умного дома."

msgid "Enable schedule"
msgstr "Включить расписание"

msgid "Networks now"
msgstr "Сети сейчас"

msgid "working"
msgstr "работает"

msgid "turned off"
msgstr "выключена"

msgid "turned off by schedule"
msgstr "выключена по расписанию"

msgid "Rules"
msgstr "Правила"

msgid "The network is off from «Off at» until «On at». If «On at» is earlier, the period crosses midnight. Days are the days the off period starts. A network switched by hand stays so until the next scheduled switch."
msgstr "Сеть выключена с «Выключить в» до «Включить в». Если «Включить в» раньше, период переходит через полночь. Дни — дни начала периода выключения. Сеть, включённую или выключенную вручную, таймер не трогает до следующего переключения по расписанию."

msgid "Enabled"
msgstr "Включено"

msgid "Network"
msgstr "Сеть"

msgid "Days"
msgstr "Дни"

msgid "Off at"
msgstr "Выключить в"

msgid "On at"
msgstr "Включить в"

msgid "Time as HH:MM, e.g. 01:00"
msgstr "Время в виде ЧЧ:ММ, например 01:00"

msgid "«Off at» and «On at» must differ"
msgstr "«Выключить в» и «Включить в» должны различаться"

msgid "Mon"
msgstr "Пн"

msgid "Tue"
msgstr "Вт"

msgid "Wed"
msgstr "Ср"

msgid "Thu"
msgstr "Чт"

msgid "Fri"
msgstr "Пт"

msgid "Sat"
msgstr "Сб"

msgid "Sun"
msgstr "Вс"

msgid "2.4 GHz"
msgstr "2.4 ГГц"

msgid "5 GHz"
msgstr "5 ГГц"

msgid "6 GHz"
msgstr "6 ГГц"

msgid "Grant access to Wi-Fi schedule"
msgstr "Доступ к расписанию Wi-Fi"
