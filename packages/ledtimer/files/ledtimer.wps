#!/bin/sh
# Кнопка WPS по настройкам из LuCI (Службы -> Диоды и кнопка).
# Если там «Управлять кнопкой» выключено — exit 1, и работает штатный /etc/rc.wps/10-vinga.
#   коротко (< 2 с) — действие short; 2–8 с — действие long; дольше 8 с — ничего.
. /lib/functions.sh
config_load ledtimer
config_get_bool en wps enabled 0
[ "$en" = 1 ] || exit 1
[ "$ACTION" = released ] || exit 0
if [ "$SEEN" -lt 2 ]; then
	config_get act wps short none
elif [ "$SEEN" -le 8 ]; then
	config_get act wps long none
else
	exit 0
fi
/usr/bin/ledtimer button "$act"
exit 0
