msgid "Telegram notifications"
msgstr "Сповіщення в Telegram"

msgid "Messages from the router to Telegram. Create a bot with @BotFather, write anything to it, then get your chat ID from @userinfobot."
msgstr "Повідомлення від роутера в Telegram. Створіть бота в @BotFather, напишіть йому будь-що, потім дізнайтеся свій chat ID у @userinfobot."

msgid "Enable"
msgstr "Увімкнути"

msgid "Bot token"
msgstr "Токен бота"

msgid "Chat ID"
msgstr "Chat ID"

msgid "Number or @channel"
msgstr "Число або @канал"

msgid "Notify when WAN connects"
msgstr "Повідомляти про підключення WAN"

msgid "Notify on SSH login"
msgstr "Повідомляти про вхід по SSH"

msgid "Test message"
msgstr "Тестове повідомлення"

msgid "Click «Save & Apply» first, then send a test."
msgstr "Спочатку натисніть «Зберегти та застосувати», потім надішліть тест."

msgid "Send test"
msgstr "Надіслати тест"

msgid "Test message from LuCI"
msgstr "Тестове повідомлення з LuCI"

msgid "Message sent"
msgstr "Повідомлення надіслано"

msgid "Sending failed: %s"
msgstr "Не вдалося надіслати: %s"

msgid "Grant access to Telegram notifications"
msgstr "Доступ до сповіщень Telegram"
