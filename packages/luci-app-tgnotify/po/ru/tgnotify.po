msgid "Telegram notifications"
msgstr "Уведомления в Telegram"

msgid "Messages from the router to Telegram. Create a bot with @BotFather, write anything to it, then get your chat ID from @userinfobot."
msgstr "Сообщения от роутера в Telegram. Создайте бота у @BotFather, напишите ему что-нибудь, затем узнайте свой chat ID у @userinfobot."

msgid "Enable"
msgstr "Включить"

msgid "Bot token"
msgstr "Токен бота"

msgid "Chat ID"
msgstr "Chat ID"

msgid "Number or @channel"
msgstr "Число или @канал"

msgid "Notify when WAN connects"
msgstr "Сообщать о подключении WAN"

msgid "Notify on SSH login"
msgstr "Сообщать о входе по SSH"

msgid "Test message"
msgstr "Тестовое сообщение"

msgid "Click «Save & Apply» first, then send a test."
msgstr "Сначала нажмите «Сохранить и применить», затем отправьте тест."

msgid "Send test"
msgstr "Отправить тест"

msgid "Test message from LuCI"
msgstr "Тестовое сообщение из LuCI"

msgid "Message sent"
msgstr "Сообщение отправлено"

msgid "Sending failed: %s"
msgstr "Не удалось отправить: %s"

msgid "Grant access to Telegram notifications"
msgstr "Доступ к уведомлениям Telegram"
